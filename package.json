{
  "name": "dystopiabench",
  "version": "0.1.0",
  "private": false,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "tsx --test lib/dystopiabench/*.test.ts",
    "bench:run": "tsx scripts/run-benchmark.ts",
    "bench:run-isolated": "tsx scripts/run-benchmark.ts --conversation-mode=stateless",
    "bench:rerun-failures": "tsx scripts/rerun-failures.ts",
    "bench:rescore-judges": "tsx scripts/rescore-judge-failures.ts",
    "bench:merge": "tsx scripts/merge-runs.ts",
    "bench:publish": "tsx scripts/publish-run.ts",
    "bench:publish-legacy": "tsx scripts/publish-legacy-results.ts",
    "bench:archive-openrouter": "tsx scripts/archive-openrouter-traces.ts",
    "bench:gate": "tsx scripts/bench-gate.ts",
    "bench:bundle:create": "tsx scripts/create-bundle.ts",
    "bench:bundle:validate": "tsx scripts/validate-bundle.ts",
    "typecheck": "tsc --noEmit",
    "check:scenarios": "tsx scripts/check-scenarios.ts",
    "check:manifests": "tsx scripts/check-manifests.ts",
    "check:library-surface": "tsx scripts/check-library-surface.ts",
    "test:exports": "tsx --test lib/dystopiabench/export-fixtures.test.ts",
    "verify:static": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:exports && pnpm check:library-surface && pnpm check:scenarios && pnpm check:manifests"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.114",
    "@openrouter/sdk": "^0.12.79",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-slot": "1.2.4",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^6.0.286",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.564.0",
    "next": "16.3.5",
    "p-limit": "^7.3.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "2.15.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "1.3.3",
    "typescript": "5.7.3"
  },
  "description": "Benchmark for evaluating whether LLMs comply with progressively dystopian directives.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/matei-anghel/DystopiaBench.git"
  },
  "bugs": {
    "url": "https://github.com/matei-anghel/DystopiaBench/issues"
  },
  "homepage": "https://github.com/matei-anghel/DystopiaBench#readme",
  "pnpm": {
    "overrides": {
      "brace-expansion@^1.1.0": "^1.1.18",
      "brace-expansion@^5.0.0": "^5.0.9",
      "flatted": "3.4.2",
      "lodash": "4.18.0",
      "picomatch@^2.0.0": "2.3.2",
      "picomatch@^4.0.0": "4.0.4",
      "postcss": "^8.5.28"
    }
  }
}
